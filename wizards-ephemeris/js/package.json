{
  "name": "wizards-ephemeris",
  "version": "0.1.0",
  "description": "Positions, houses, and ayanamsas for a natal chart, compiled to WebAssembly.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://wizards-ephemeris.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wizards-ephemeris/wizards-ephemeris.git"
  },
  "bugs": {
    "url": "https://github.com/wizards-ephemeris/wizards-ephemeris/issues"
  },
  "keywords": [
    "astrology",
    "ephemeris",
    "houses",
    "ayanamsa",
    "webassembly"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc && node scripts/prepack.mjs",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.0",
    "vite": "^7.1.11"
  }
}
