{
  "name": "@magowie/wizards-ephemeris",
  "version": "0.1.0",
  "private": true,
  "description": "Positions, houses, and ayanamsas for a natal chart, compiled to WebAssembly.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc && node scripts/prepack.mjs",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.0",
    "vite": "^7.1.11"
  }
}
